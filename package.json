{
  "name": "@lsrweb/element-plus-mcp",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "MCP server that searches Element Plus component docs, guides and Vue examples from a local documentation checkout",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/lsrweb/element-plus-mcp.git" },
  "homepage": "https://github.com/lsrweb/element-plus-mcp#readme",
  "keywords": ["mcp", "model-context-protocol", "element-plus", "vue", "documentation"],
  "engines": { "node": ">=20" },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "element-plus-mcp": "dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "e2e": "node scripts/e2e.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
